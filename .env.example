# === LLM Provider ===
# Default: Groq (free tier, fast Llama models). Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Alternative free/cheap providers (all OpenAI-compatible, just swap the 3 values above) ---
# Cerebras (free tier, very fast):         LLM_BASE_URL=https://api.cerebras.ai/v1                              LLM_MODEL=llama-3.3-70b
# Together AI (free credits):              LLM_BASE_URL=https://api.together.xyz/v1                             LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# OpenRouter (many free models):           LLM_BASE_URL=https://openrouter.ai/api/v1                            LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Google Gemini (free tier, OpenAI-compat): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai LLM_MODEL=gemini-2.0-flash

# === Database / storage (defaults are fine) ===
DATABASE_PATH=./triallens.db
CHROMA_PATH=./chroma_data
MAX_INGEST_RESULTS=50
